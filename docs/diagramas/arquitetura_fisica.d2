# Arquitetura física: Raspberry Pi 4 + Freenove Projects Board v1.2
# Renderizar com: d2 arquitetura_fisica_ajustada.d2 arquitetura_fisica_ajustada.svg

direction: right

pi: "Raspberry Pi 4" {
  shape: rectangle
  style.fill: "#c9184a"
  style.font-color: "#ffffff"
}

monitor: "Monitor HDMI\n(jogo em Pygame)" {
  shape: rectangle
}

i2c: "Barramento I²C-1\nSDA=GPIO2 · SCL=GPIO3" {
  adc: "ADS7830 (0x48)\npotenciômetro e entradas analógicas"
  lcd: "LCD1602 (0x27)\nscore e nível"
}

spi: "Barramento SPI0\nMOSI=GPIO10 · MISO=GPIO9\nSCLK=GPIO11 · CE0=GPIO8" {
  rfid: "MFRC522\nseleção opcional de dificuldade"
}

hc595: "Barramento compartilhado 74HC595\nDS=GPIO22 · ST_CP=GPIO27 · SH_CP=GPIO17" {
  matrix: "Matriz LED 8×8"
  bar: "LED Bar Graph"
  seg: "Display de 4 dígitos"
}

gpio: "GPIO diretos" {
  joy_sw: "Botão do joystick SW (GPIO7)\nconfirmar e pausar"
  btn_up: "Botão azul (GPIO20)\ncima"
  btn_dn: "Botão vermelho (GPIO21)\nbaixo"
  btn_lf: "Botão amarelo (GPIO26)\nesquerda"
  btn_rt: "Botão verde (GPIO16)\ndireita"
  buz_a: "Buzzer ativo (GPIO12)"
  buz_p: "Buzzer passivo (GPIO4)"
}

pi -> monitor: HDMI
pi -> i2c: I²C
pi -> spi: SPI
pi -> hc595: GPIO serial
pi -> gpio: GPIO
